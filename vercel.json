{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/join/:code", "destination": "/api/join?code=:code" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}